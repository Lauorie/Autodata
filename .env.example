# Copy to .secrets/remote.env and fill in your values.
# `.secrets/` is gitignored.

# Required: OpenAI-compatible chat-completions endpoint + bearer token.
# Examples:
#   - OpenRouter:  PROXY_BASE_URL=https://openrouter.ai/api/v1
#   - Anthropic:   PROXY_BASE_URL=https://api.anthropic.com/v1   (use Claude SDK directly instead)
#   - Self-hosted vLLM: PROXY_BASE_URL=http://localhost:8000/v1
PROXY_BASE_URL=
PROXY_API_KEY=

# Optional: extra header your proxy needs (e.g. account/channel routing).
# Leave blank if not required.
PROXY_HEADER_X_CHANNEL=

# Optional: the weak solver served by vLLM (scripts/serve_weak_solver.sh).
WEAK_SOLVER_BASE_URL=http://127.0.0.1:8000/v1

# Optional: the run box, used only by scripts/sync_to_remote.sh and
# scripts/sync_from_remote.sh. Leave REMOTE_PASSWORD empty for key auth.
REMOTE_HOST=
REMOTE_PORT=22
REMOTE_USER=root
REMOTE_PASSWORD=
REMOTE_REPO_DIR=/root/autodata
REMOTE_OUTPUTS_DIR=/root/autodl-fs/autodata/outputs
